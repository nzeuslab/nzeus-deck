#!/bin/sh
### BEGIN INIT INFO
# Provides:          nzeus-power-sleep
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Enable the tested R36SX short-power-press s2idle mode
### END INIT INFO
parameter=/sys/module/nzeus_r36s_power/parameters/sleep_on_short_press
case "$1" in
 start) [ ! -w "$parameter" ] || echo Y > "$parameter" ;;
 stop) [ ! -w "$parameter" ] || echo N > "$parameter" ;;
 restart|force-reload) "$0" stop; "$0" start ;;
 status) [ ! -r "$parameter" ] || cat "$parameter" ;;
 *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
exit 0
