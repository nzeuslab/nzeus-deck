# /etc/inittab - NZEUS R36S SD root (BusyBox init, runlevels are ignored).
#
# How we get here: the kernel's RAM initramfs (linux-port/init) checked the
# card, mounted this file system READ-ONLY and did switch_root. It already
# mounted /dev, /proc, /sys and /run and moved them here.
# /etc/init.d/S01nzroot checks the file system (e2fsck) while it is still
# read-only and only then makes it writable. If the check fails the system
# stays read-only - it never repairs by force.

::sysinit:/etc/init.d/rcS

# Root shell on the USB cable (the same ttyGS0 gadget the RAM rescue used),
# same behaviour as /usb-rescue so rescue-command.py / rescue-upload.py work
# unchanged. Shared with the Debian root: /usr/local/sbin/nzeus-usb-shell
# (installed by post-build.sh). No password: the cable is the only way in.
# (Before 2026-10-09 this was getty + /usr/sbin/nz-autologin, now unused.)
ttyGS0::respawn:/usr/local/sbin/nzeus-usb-shell

# A shell on the screen console for a future USB keyboard (waits for Enter).
tty1::askfirst:-/bin/sh

::ctrlaltdel:/sbin/reboot

# Stopping: services first, then swap, then make every file system read-only.
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/sync
::shutdown:/bin/umount -a -r
