#!/bin/sh
# nzeus-clock restore|keep|save - the console's clock on the SD Linux.
# The console has no clock chip and no clock battery: every start begins in
# 1970, so the time is saved in /data/nzeus/clock.txt:
#   line 1: seconds since 1970      line 2: "YYYY-MM-DD HH:MM:SS UTC"
#   restore  at start-up (after /data is mounted): set the clock to the saved
#            time, only if the clock is behind it (it can't know how long the
#            console was off; the network fixes it later)
#   keep     in the background: save every 5 minutes
#   save     save now (also done at power-off / restart)
# Saving goes ONLY to /data/nzeus/clock.txt, and only while /data is mounted:
# a .tmp file, then a rename, so a power cut never leaves half a file.
# Works with dash, bash and BusyBox ash.
# NZ_CLOCK_* variables are for the PC test only.
DATA=${NZ_CLOCK_DATA:-/data}
DATA_FILE=$DATA/nzeus/clock.txt
EVERY=${NZ_CLOCK_EVERY:-300}             # seconds between saves (keep)
DATE=${NZ_CLOCK_DATE:-date}              # (tests: a fake date that changes nothing)
MOUNTED=${NZ_CLOCK_MOUNTED:-mountpoint -q}
MIN=1704067200                           # 2024-01-01: anything older is "not set"

now() { $DATE +%s; }
saved() {                                # the seconds in clock.txt $1, or 0
    s=$(head -n 1 "$1" 2>/dev/null)
    case "$s" in
        ''|*[!0-9]*) echo 0 ;;
        *) if test "$s" -ge $MIN; then echo "$s"; else echo 0; fi ;;
    esac
}
save() {
    t=$(now)
    case "$t" in ''|*[!0-9]*) return 1 ;; esac
    test "$t" -ge $MIN || return 1       # not set yet (1970): keep the saved time
    $MOUNTED "$DATA" || return 1         # /data not mounted: never write the root's /data folder
    mkdir -p "${DATA_FILE%/*}" || return 1
    if { echo "$t"; $DATE -u '+%Y-%m-%d %H:%M:%S UTC'; } > "$DATA_FILE.tmp" && mv -f "$DATA_FILE.tmp" "$DATA_FILE"; then
        return 0
    fi
    rm -f "$DATA_FILE.tmp"
    return 1
}

case "$1" in
restore)
    s=$(saved "$DATA_FILE"); f=$DATA_FILE
    test "$s" -gt 0 || { echo "clock: nothing saved yet"; exit 0; }
    test "$(now)" -lt "$s" || { echo "clock: already right"; exit 0; }
    w=$(sed -n 2p "$f" | cut -c1-19)     # "YYYY-MM-DD HH:MM:SS" (UTC)
    case "$w" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]\ [0-9][0-9]:[0-9][0-9]:[0-9][0-9]) ;;
        *) echo "clock: line 2 of $f is not a date; not set"; exit 0 ;;
    esac
    $DATE -u -s "$w" > /dev/null && echo "clock: set to $w UTC (from $f)"
    ;;
keep)
    while :; do
        sleep "$EVERY"
        save
    done
    ;;
save)
    if save; then echo "clock: saved"; else echo "clock: not saved (clock not set, or /data not mounted)"; exit 1; fi
    ;;
*)
    echo "usage: $0 restore|keep|save" >&2
    exit 2
    ;;
esac
exit 0
