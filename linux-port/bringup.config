# Merge AFTER upstream sf3000_defconfig; this is not a complete .config.
# Resolved and built on 2026-10-07; see artifacts/kernel.config. Hardware untested.
CONFIG_DEFAULT_HOSTNAME="nzeus-linux"
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Keep initial diagnostics on UART; no claim that USB host or display works.
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
# The factory AVP remains active: leave the shared south timers alone.
# apply-port-patches.py selects the CPU-local Count/Compare timer instead.
# CONFIG_HC16XX_TIMER is not set
