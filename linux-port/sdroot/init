#!/bin/sh
# /init of the gma-native-sdroot initramfs (linux-port/sdroot/README.md).
# Starts the Linux system on the SD card (mmcblk0p3 "nzroot") ONLY when
# nz-sdboot says every check passed. On ANY failure it continues exactly like
# the RAM rescue system always did (linux-port/init): USB rescue shell
# (NZEUS-RAM-RESCUE-01) plus a serial shell. This script never writes the card.
# Boot shell rule: no '[' - use 'test'.
# --- fixed paths: test-sdroot-init.sh replaces ONLY these lines in a copy ---
export PATH=/bin
NEWROOT=/newroot
SDBOOT=/bin/nz-sdboot
RESCUE=/usb-rescue
MOUNTS=/proc/mounts
KMSG=/dev/kmsg
LOG=/run/nzeus-sdboot.log
MOUNT_WAIT=20
# --- end of fixed paths ---
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /dev/pts
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts

sd_say() {
    echo "NZEUS SD root: $*"
    echo "NZEUS SD root: $*" >> "$LOG"
    echo "<5>nzeus-sdroot: $*" > "$KMSG" 2> /dev/null
}

# Undo a partly done switch: put moved mounts back, unmount the SD root.
sd_undo() {
    for d in run sys proc dev; do
        if mountpoint -q "$NEWROOT/$d"; then
            mount --move "$NEWROOT/$d" "/$d" || sd_say "could not move /$d back"
        fi
    done
    mountpoint -q /tmp || mount -t tmpfs tmpfs /tmp
    if mountpoint -q "$NEWROOT"; then
        umount "$NEWROOT" || sd_say "could not unmount $NEWROOT (left mounted read-only)"
    fi
}

sd_try() {
    if ! $SDBOOT --log "$LOG"; then
        return 1
    fi
    if ! type switch_root > /dev/null 2>&1; then
        sd_say 'switch_root is missing from this BusyBox'
        return 1
    fi
    sd_say 'mounting mmcblk0p3 (nzroot) read-only at /newroot'
    # In the background, so a card that never answers cannot stop the rescue.
    rc_file=$NEWROOT.rc
    ( mount -t ext4 -o ro,noatime /dev/mmcblk0p3 "$NEWROOT"; echo $? > "$rc_file" ) &
    n=0
    while ! test -s "$rc_file"; do
        n=$((n + 1))
        if test "$n" -gt "$MOUNT_WAIT"; then
            sd_say "mount did not finish within $MOUNT_WAIT s"
            return 1
        fi
        sleep 1
    done
    if test "$(cat "$rc_file")" != 0 || ! mountpoint -q "$NEWROOT"; then
        sd_say 'mount of mmcblk0p3 failed'
        sd_undo
        return 1
    fi
    if ! grep -q "^/dev/mmcblk0p3 $NEWROOT ext4 ro[, ]" "$MOUNTS"; then
        sd_say 'mmcblk0p3 is not mounted read-only as ext4'
        sd_undo
        return 1
    fi
    if ! $SDBOOT --check-init "$NEWROOT" --log "$LOG"; then
        sd_undo
        return 1
    fi
    for p in 1 2 5; do
        if test "$(blockdev --getro /dev/mmcblk0p$p)" != 1; then
            sd_say "mmcblk0p$p is not read-only in the kernel"
            sd_undo
            return 1
        fi
    done
    for d in dev proc sys run; do
        if ! test -d "$NEWROOT/$d"; then
            sd_say "the SD root has no /$d folder"
            sd_undo
            return 1
        fi
    done
    sd_say 'all checks passed: exec switch_root /newroot /sbin/init'
    umount /tmp
    for d in dev proc sys run; do
        if ! mount --move "/$d" "$NEWROOT/$d"; then
            echo "NZEUS SD root: could not move /$d"
            sd_undo
            return 1
        fi
    done
    exec switch_root "$NEWROOT" /sbin/init
}

if ! sd_try; then
    sd_say 'staying in the RAM rescue system'
fi

# ---- from here on: exactly the RAM rescue system of linux-port/init ----
# A USB terminal may work without a UART adapter once the USB driver is running.
/bin/sh "$RESCUE" &
echo
echo 'NZEUS experimental Linux: serial rescue system'
uname -a
echo 'No SD card or internal flash filesystem has been mounted.'
echo 'This build has not been validated on R36S hardware.'
echo 'Useful commands: free, cat /proc/iomem, ip link, dmesg'
echo
while true; do
    setsid cttyhack /bin/sh
    echo 'Shell exited; starting another shell.'
    sleep 1
done
