#!/bin/sh
# /init of the public NZEUS Deck kernel (copy-and-go install, see
# docs/specs/2026-11-18-copy-and-go-installer-design.md).
# Starts NZEUS Deck from files on the SD card's normal FAT32 partition:
# nz-fatroot loop-mounts nzeus/nzroot.img as the new root and nzeus/nzdata.img
# as /data. The FAT32 itself becomes /sdcard. On ANY failure it shows a short
# message on the screen and continues exactly like the RAM rescue system
# (ports/r36s-hichip/init): USB rescue shell plus a serial shell.
# Boot shell rule: no '[' - use 'test'.
# --- fixed paths: test-fatroot-init.py replaces ONLY these lines in a copy ---
export PATH=/bin
NEWROOT=/newroot
FATROOT=/bin/nz-fatroot
RESCUE=/usb-rescue
CARD=/dev/mmcblk0
FAT=/fat
DATA=/data0
KMSG=/dev/kmsg
LOG=/run/nzeus-fatroot.log
CARD_WAIT=10
ATTACH_WAIT=300
# --- end of fixed paths ---
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mkdir -p /dev/pts
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts

# Say it on the serial port, in the log and in the kernel log.
fr_say() {
    echo "NZEUS: $*"
    echo "NZEUS: $*" >> "$LOG"
    echo "<5>nzeus-fatroot: $*" > "$KMSG" 2> /dev/null
}

# Say it on the console's screen too (the kernel has no text console there).
fr_show() {
    fr_say "$*"
    "$FATROOT" show "NZEUS could not start: $*" > /dev/null 2>&1
}

# The boot log on the card (nzeus/boot-log.txt): this RAM disk's log plus every
# kernel message so far, synced to the card NOW - if the start freezes later, a
# PC can still read it. The Debian part (nzeus-bootlog) adds to the same file.
# The log of the start before is kept as boot-log-previous.txt. Never stops the start.
fr_bootlog() {
    test -d "$FAT/nzeus" || return 0
    bl=$FAT/nzeus/boot-log.txt
    if test -f "$bl"; then mv -f "$bl" "$FAT/nzeus/boot-log-previous.txt"; fi
    {
        echo '== NZEUS boot log, part 1: start-up RAM disk =='
        cat "$LOG"
        echo '== kernel messages so far =='
        dmesg
    } > "$bl" 2>&1
    sync
    return 0
}

# Undo a partly done switch: put moved mounts back, unmount the card's files.
fr_undo() {
    for d in run sys proc dev; do
        if mountpoint -q "$NEWROOT/$d"; then
            mount --move "$NEWROOT/$d" "/$d" || fr_say "could not move /$d back"
        fi
    done
    mountpoint -q /tmp || mount -t tmpfs tmpfs /tmp
    "$FATROOT" detach "$NEWROOT"
}

fr_try() {
    # 1. wait for the SD card
    n=0
    while ! test -e "$CARD"; do
        n=$((n + 1))
        if test "$n" -gt "$CARD_WAIT"; then
            fr_show "no SD card found"
            return 1
        fi
        sleep 1
    done
    # 2. FAT32 + nzroot.img + nzdata.img (checked with e2fsck first). In the
    #    background, so a card that never answers cannot stop the rescue.
    rc_file=$LOG.rc
    ( "$FATROOT" attach "$CARD" "$NEWROOT" >> "$LOG" 2>&1; echo $? > "$rc_file" ) &
    n=0
    while ! test -s "$rc_file"; do
        n=$((n + 1))
        if test "$n" -gt "$ATTACH_WAIT"; then
            fr_show "starting took too long (the SD card may be failing)"
            return 1
        fi
        sleep 1
    done
    if test "$(cat "$rc_file")" != 0; then
        why=$(grep '^fatroot:' "$LOG" | tail -n 1)
        fr_show "${why#fatroot: }"
        return 1
    fi
    # 3. is it really a NZEUS system?
    if ! test -x "$NEWROOT/sbin/init"; then
        fr_show "nzroot.img has no /sbin/init (copy it again with install.bat)"
        fr_undo
        return 1
    fi
    for d in dev proc sys run sdcard data; do
        if ! test -d "$NEWROOT/$d"; then
            fr_show "nzroot.img has no /$d folder (copy it again with install.bat)"
            fr_undo
            return 1
        fi
    done
    # 3b. can nzroot.img really RUN programs? Its own loader runs its own shell, straight
    #     from the image. On this console the loop devices once gave programs stale bytes
    #     (CPU copy + aliasing data cache) while files still read fine: Debian's init died
    #     at the switch and the screen froze. If this fails: NO switch - message on the
    #     screen, boot log on the card, then the rescue system (USB shell).
    said=$("$NEWROOT/lib/ld.so.1" --library-path "$NEWROOT/lib/mipsel-linux-gnu" "$NEWROOT/bin/sh" -c 'echo nzroot-runs' 2>&1)
    rc=$?
    fr_say "test run of nzroot.img's /bin/sh: exit $rc ($said)"
    if test "$rc" != 0 || test "$said" != nzroot-runs; then
        fr_show "nzroot.img can't run programs on this console (exit $rc)"
        fr_bootlog
        fr_undo
        return 1
    fi
    # 4. the boot log onto the card, while the card's FAT32 is still at $FAT
    fr_say 'all checks passed: exec switch_root /newroot /sbin/init'
    fr_bootlog
    # 5. the card's files and the user's data go into the new system
    if ! mount --move "$FAT" "$NEWROOT/sdcard" || ! mount --move "$DATA" "$NEWROOT/data"; then
        fr_show "could not prepare /sdcard and /data"
        fr_undo
        return 1
    fi
    umount /tmp
    for d in dev proc sys run; do
        if ! mount --move "/$d" "$NEWROOT/$d"; then
            echo "NZEUS: could not move /$d"
            fr_undo
            return 1
        fi
    done
    exec switch_root "$NEWROOT" /sbin/init
}

if ! fr_try; then
    fr_say 'staying in the RAM rescue system'
fi

# ---- from here on: exactly the RAM rescue system of ports/r36s-hichip/init ----
# A USB terminal may work without a UART adapter once the USB driver is running.
/bin/sh "$RESCUE" &
echo
echo 'NZEUS experimental Linux: serial rescue system'
uname -a
echo 'No SD card or internal flash filesystem has been mounted.'
echo 'This build has not been validated on R36S hardware.'
echo 'Useful commands: free, cat /proc/iomem, ip link, dmesg'
echo
while true; do
    setsid cttyhack /bin/sh
    echo 'Shell exited; starting another shell.'
    sleep 1
done
