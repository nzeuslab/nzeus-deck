#!/bin/sh
# NZEUS: basic RAM/kernel file systems. The initramfs normally moved /dev,
# /proc, /sys and /run here already; anything missing is mounted now.
case "$1" in start) ;; *) exit 0 ;; esac
m() { mountpoint -q "$2" || mount -t "$1" -o "$3" "$1" "$2"; }
m proc /proc defaults
m sysfs /sys defaults
m devtmpfs /dev mode=0755
mkdir -p /dev/pts /dev/shm
m devpts /dev/pts gid=5,mode=620,ptmxmode=0666
m tmpfs /dev/shm mode=0777,size=4m
m tmpfs /tmp mode=1777,size=8m
m tmpfs /run mode=0755,nosuid,nodev,size=2m
mkdir -p /run/lock/subsys
ln -sf /proc/self/fd /dev/fd
ln -sf /proc/self/fd/0 /dev/stdin
ln -sf /proc/self/fd/1 /dev/stdout
ln -sf /proc/self/fd/2 /dev/stderr
hostname -F /etc/hostname
exit 0
