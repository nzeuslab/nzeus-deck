# NZEUS R36S modern-Linux root file system (userspace ONLY).
# Buildroot 2025.02.x, used as an external tree:
#   make -C <buildroot> BR2_EXTERNAL=<repo>/ports/r36s-hichip/rootfs/buildroot O=<out> nzeus_r36s_defconfig
#   make -C <buildroot> O=<out>
# We build the kernel ourselves (ports/r36s-hichip/), so Buildroot builds no kernel and
# no bootloader. Building never touches a card or a console (lab rule 8).

# --- CPU: HiChip E3100 = MIPS 74Kc, little-endian, MIPS32r2 with an FPU ---
BR2_mipsel=y
BR2_mips_32r2=y
# hard float (the 74Kc has an FPU); FP mode xx = works with FR=0 and FR=1 kernels
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_XX=y
# Buildroot has no 74kc CPU entry: build for MIPS32r2 and tune for the 74K pipeline.
BR2_TARGET_OPTIMIZATION="-mtune=74kc"
BR2_OPTIMIZE_S=y

# --- Toolchain: Buildroot's own, musl (small libc for a 128 MiB machine) ---
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# Kernel headers = the exact kernel we run (SiarheiVolkau/linux-hichip hc16xx-7.2,
# pinned commit, same as ports/r36s-hichip/README.md). Buildroot only knows "6.12 or
# later", which is the correct choice for 7.2 headers.
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="https://github.com/SiarheiVolkau/linux-hichip/archive/da5f1a22ef2ff5c46aa3f750fa10825813970b09.tar.gz"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_ENABLE_LOCALE_PURGE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US"

# --- System ---
BR2_TARGET_GENERIC_HOSTNAME="nzeus"
BR2_TARGET_GENERIC_ISSUE="NZEUS R36S - modern Linux (SD root)"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_ENABLE_ROOT_LOGIN=y
# Empty root password: the only login is the USB cable (ttyGS0, autologin).
# Dropbear refuses empty passwords, so SSH needs a key in /root/.ssh/authorized_keys.
BR2_TARGET_GENERIC_ROOT_PASSWD=""
# Our own inittab (overlay) puts the login on the USB serial gadget.
# BR2_TARGET_GENERIC_GETTY is not set
# Root goes read-write only via S01nzroot after e2fsck (never unconditionally):
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NZEUS_ROOTFS_PATH)/board/nzeus-r36s/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NZEUS_ROOTFS_PATH)/board/nzeus-r36s/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_NZEUS_ROOTFS_PATH)/board/nzeus-r36s/post-image.sh"

# --- No kernel, no bootloader (the factory bootloader starts our own kernel) ---
# BR2_LINUX_KERNEL is not set

# --- Packages ---
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NZEUS_ROOTFS_PATH)/board/nzeus-r36s/busybox.fragment"
# needed to offer fbset and i2c-tools (BusyBox has smaller versions of them)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# file systems: e2fsck/tune2fs/resize2fs for the SD root and /data
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# remote login (key-based) and editors / tools
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_HTOP=y
# hardware tools
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_FBSET=y
BR2_PACKAGE_I2C_TOOLS=y
# Wi-Fi tools for later (no Wi-Fi driver yet): nl80211, WPA3 (needs OpenSSL)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_CA_CERTIFICATES=y
# Python 3 (compiled .pyc only, to save space) with ssl, zlib and readline
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_READLINE=y

# --- Images: a tarball (the region tool builds the real ext4 from it) and a
# small ext4 for PC/QEMU checks. Neither is ever written to a card by Buildroot.
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="nzroot"
BR2_TARGET_ROOTFS_EXT2_SIZE="160M"
# BR2_TARGET_ROOTFS_EXT2_GZIP is not set
