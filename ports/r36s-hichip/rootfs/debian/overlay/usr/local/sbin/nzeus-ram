#!/bin/sh
# nzeus-ram - pure-Linux mode: give the ~79 MiB the factory AVP used to own to
# Linux (MemTotal ~38 -> ~118 MiB). The kernel driver (nzeus-ram, kernels pure /
# net / sdroot) checks for 10 s that the AVP areas are static and REFUSES while
# the factory AVP runs, so this is safe on any card; it only says what happened.
# Same step as ports/r36s-hichip/purelinux/avpfree-release.sh, proven on hardware
# 2026-10-10 (38812 -> 119968 kB, memstress 80 MiB x 3 errors=0).
# Works with dash, bash and BusyBox ash. NZ_* variables: PC test only.
SYS=${NZ_SYS:-/sys}
PROC=${NZ_PROC:-/proc}

D=$(ls -d "$SYS"/bus/platform/devices/*avp-free-ram 2>/dev/null | head -n 1)
test -n "$D" || { echo "ram: this kernel has no nzeus-ram device: nothing to do"; exit 0; }
case "$(cat "$D/release" 2>/dev/null)" in
    RELEASED*) echo "ram: already given to Linux"; exit 0 ;;
esac
before=$(awk '/^MemTotal:/ { print $2 }' "$PROC/meminfo")
if echo release > "$D/release" 2>/dev/null; then
    after=$(awk '/^MemTotal:/ { print $2 }' "$PROC/meminfo")
    echo "ram: AVP area given to Linux (MemTotal $before -> $after KiB)"
else
    echo "ram: the kernel refused (factory AVP running?): MemTotal stays $before KiB"
fi
exit 0
