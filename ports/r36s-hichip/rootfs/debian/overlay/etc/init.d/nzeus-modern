#!/bin/sh
### BEGIN INIT INFO
# Provides:          nzeus-modern
# Required-Start:    $local_fs nzeus-data
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: NZEUS: start NZEUS Deck on the screen, only if asked for
### END INIT INFO
# At power-on NZEUS Deck starts ONLY if one of these flag files exists:
#   /data/nzeus/autostart-modern      /etc/nzeus/autostart-modern
# By hand at any time: nzeus-deck start | stop | status
case "$1" in
    start)
        if test -e /data/nzeus/autostart-modern || test -e /etc/nzeus/autostart-modern; then
            /usr/local/bin/nzeus-deck start
        else
            echo "nzeus-modern: not started (no autostart flag; 'nzeus-deck start' starts it by hand)"
        fi
        ;;
    stop) /usr/local/bin/nzeus-deck stop ;;
    restart|force-reload) /usr/local/bin/nzeus-deck stop; /usr/local/bin/nzeus-deck start ;;
    status) /usr/local/bin/nzeus-deck status ;;
    *) echo "Usage: $0 start|stop|restart|status" >&2; exit 3 ;;
esac
exit 0
